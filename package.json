{
  "name": "workspace-root",
  "private": true,
  "repository": {
    "type": "git",
    "url": "git@github.com:NullVoxPopuli/ember-composable-helpers.git"
  },
  "license": "MIT",
  "author": "",
  "scripts": {
    "build": "pnpm --filter ember-composable-helpers build",
    "format": "pnpm -r --if-present format",
    "lint": "pnpm -r --if-present lint",
    "lint:fix": "pnpm -r --if-present lint:fix",
    "start": "concurrently 'pnpm:start:*' --restart-after 5000 --prefix-colors cyan,white,yellow",
    "start:addon": "pnpm --filter ember-composable-helpers start --no-watch.clearScreen",
    "start:test-app": "pnpm --filter test-app start",
    "test": "pnpm -r --workspace-concurrency=1 --if-present test"
  },
  "devDependencies": {
    "@glint/core": "^1.5.2",
    "concurrently": "^9.1.2",
    "prettier": "^3.5.2",
    "prettier-plugin-ember-template-tag": "^2.0.4",
    "release-plan": "^0.18.0"
  },
  "packageManager": "pnpm@12.16.1+sha512.091d1dee7927575661b25dab3c2ae31cafc1c54d6b71ed6a6600cf0c1cb10434a447eae14015f1b23e2e6bedeed79df94a932e2164d2832280dce3fb32f656d1",
  "engines": {
    "node": "20.12.2"
  }
}
